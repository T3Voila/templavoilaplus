      <trans-unit id="infoDoktypeShortcutCannotEdit0" resname="infoDoktypeShortcutCannotEdit0">
        <source>This page is of the type "shortcut". Instead of having content on its own, this page shows the content from the selected page "%s". Therefore you cannot edit the content of this page directly.</source>
